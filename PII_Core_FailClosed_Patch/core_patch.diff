+        raise SafeOutputError("輸出不存在、為空或是不允許的符號連結")
+    if os.path.samefile(source, candidate) or _file_digest(source) == _file_digest(candidate):
+        raise SafeOutputError("疑似未遮蔽原稿，不允許發布")
+    if not media:
