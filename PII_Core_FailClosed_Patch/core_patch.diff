+def _private_temp(parent):
+    os.makedirs(parent, exist_ok=True)
+    result = tempfile.mkdtemp(prefix=".pii_private_stage_", dir=parent)
+    try:
+        os.chmod(result, 0o700)
+    except OSError:
+        pass
+    return result
+
